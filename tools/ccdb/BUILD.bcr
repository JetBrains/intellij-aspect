load("@rules_java//java:defs.bzl", "java_library")
load(":ccdb.bzl", "ccdb")
load(":java_25_binary.bzl", "java_25_binary")

java_library(
    name = "json_scanner",
    srcs = ["JsonScanner.java"],
    tags = ["manual"],
    visibility = ["//visibility:private"],
)

