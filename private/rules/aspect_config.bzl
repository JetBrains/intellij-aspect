load("@rules_pkg//pkg:providers.bzl", "PackageFilesInfo")

_ASPECT_FILE_TEMPLATE = """# generated by //private/rules:aspect_config.bzl - do not edit

load("//intellij:aspect.bzl", "intellij_configure_aspect")
{loads}

MODULES = [
{modules}
]

{name} = intellij_configure_aspect(
    modules = MODULES,
    container = "{container}",
)
"""

_AspectModule = provider(
    doc = "Internal provider to pass an aspect module definition to a rule.",
    fields = ["file", "rulesets"],
)

def _aspect_module_impl(ctx):
    return [_AspectModule(file = ctx.attr.file, rulesets = ctx.attr.rulesets)]

_aspect_module = rule(
    implementation = _aspect_module_impl,
    attrs = {
        "file": attr.string(mandatory = True),
        "rulesets": attr.string_list(default = []),
    },
)

def _parse_location(location):
    """Splits a `<file>%<name>` location into its file and aspect name."""
    parts = location.split("%")
    if len(parts) != 2 or not parts[0] or not parts[1]:
        fail("invalid aspect location %r, expected '<file>%%<name>'" % location)

    return parts[0], parts[1]

def _generate_aspect_file(modules, name, container):
    return _ASPECT_FILE_TEMPLATE.format(
        loads = "\n".join([
            'load("//modules:%s.bzl", %s = "module")' % (file, file)
            for file in sorted([module.file for module in modules])
        ]),
        modules = "\n".join(["    %s," % module.file for module in modules]),
        name = name,
        container = container,
    )

def _generate_aspect_description(modules, name, destination):
    return proto.encode_text(struct(
        file = destination,
        name = name,
        modules = [struct(file = it.file, rulesets = it.rulesets) for it in modules],
    ))

def _aspect_config_impl(ctx):
    modules = [it[_AspectModule] for it in ctx.attr.modules]
    file, name = _parse_location(ctx.attr.location)

    # path of the aspect file relative to the aspect root, i.e. the repository root
    destination = "%s/%s" % (ctx.label.package, file) if ctx.label.package else file

    ctx.actions.write(
        ctx.outputs.bzl,
        _generate_aspect_file(modules, name, ctx.attr.container),
    )

    ctx.actions.write(
        ctx.outputs.textproto,
        _generate_aspect_description(modules, name, destination),
    )

    return [
        DefaultInfo(files = depset([ctx.outputs.bzl, ctx.outputs.textproto])),
        PackageFilesInfo(dest_src_map = {destination: ctx.outputs.bzl}),
    ]

_aspect_config = rule(
    implementation = _aspect_config_impl,
    attrs = {
        "modules": attr.label_list(
            mandatory = True,
            providers = [_AspectModule],
            doc = "modules to enable for this aspect configuration",
        ),
        "location": attr.string(
            mandatory = True,
            doc = "location of the deployed aspect as `<file>%<name>`, with the file relative to this package",
        ),
        "container": attr.string(
            default = "//:module_container",
            doc = "label of the module container used by the generated aspect",
        ),
    },
    outputs = {
        "bzl": "%{name}.bzl",
        "textproto": "%{name}.textproto",
    },
)

def aspect_config(name, modules, **kwargs):
    """Creates an aspect configuration from a list of module structs (see //modules:module.bzl)."""
    for module in modules:
        _aspect_module(
            name = "%s_%s" % (name, module.file),
            file = module.file,
            rulesets = module.rulesets,
        )

    _aspect_config(
        name = name,
        modules = ["%s_%s" % (name, module.file) for module in modules],
        **kwargs
    )
